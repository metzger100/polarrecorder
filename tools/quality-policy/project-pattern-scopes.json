{
  "note": "Project-owned file-scope glob patterns for tools/check-patterns/generic/*.mjs and project/*.mjs rule definitions (Tier 1 checker, Tier 2 data), keyed by rule id. Generic rule-def files import a rule's scope from here instead of embedding a literal product path.",
  "canonicalGenericRuleNames": [
    "absolute-home-path",
    "exec-plan-reference",
    "no-nul-byte",
    "unsafe-html-dom-sink",
    "dead-code",
    "console-in-runtime",
    "default-truthy-fallback",
    "redundant-null-type-guard",
    "empty-catch",
    "premature-legacy-support",
    "unused-fallback",
    "responsive-layout-hard-floor",
    "canvas-api-typeof-guard",
    "try-finally-canvas-drawing",
    "todo-without-owner",
    "duplicate-functions",
    "duplicate-block-clones",
    "catch-fallback-without-suppression",
    "internal-contract-fallback",
    "framework-method-typeof-guard",
    "invalid-lint-suppression"
  ],
  "scopes": {
    "absolute-home-path": {
      "include": [
        "**/*.md",
        "**/*.js",
        "**/*.mjs",
        "**/*.py",
        "**/*.json",
        "**/*.sh",
        "**/*.css",
        "**/*.html",
        "**/*.txt",
        "**/*.yml",
        "**/*.yaml"
      ],
      "exclude": [
        "tools/**",
        "tests/**",
        "releases/**",
        "exec-plans/**",
        ".claude/**",
        ".vscode/**",
        "package-lock.json"
      ]
    },
    "exec-plan-reference": {
      "include": [
        "**/*.md",
        "**/*.js",
        "**/*.mjs",
        "**/*.py",
        "**/*.json",
        "**/*.jsonc",
        "**/*.toml",
        "**/*.sh",
        "**/*.css",
        "**/*.html",
        "**/*.txt",
        "**/*.yml",
        "**/*.yaml"
      ],
      "exclude": [".claude/**", ".vscode/**", "releases/**", "exec-plans/**"]
    },
    "no-nul-byte": {
      "include": [
        "**/*.md",
        "**/*.js",
        "**/*.mjs",
        "**/*.py",
        "**/*.json",
        "**/*.jsonc",
        "**/*.toml",
        "**/*.sh",
        "**/*.css",
        "**/*.html",
        "**/*.txt",
        "**/*.yml",
        "**/*.yaml"
      ],
      "exclude": [".claude/**", ".vscode/**", "releases/**", "exec-plans/**"]
    },
    "js-runtime-default": { "include": ["viewer/*.js", "plugin.js", "plugin.mjs"] },
    "console-in-runtime": { "include": ["plugin.js", "plugin.mjs"] },
    "todo-without-owner": {
      "include": [
        "viewer/*.js",
        "plugin.js",
        "plugin.mjs",
        "server/polarrecorder/**/*.py",
        "documentation/**/*.md",
        "AGENTS.md",
        "ARCHITECTURE.md",
        "CLAUDE.md",
        "CONTRIBUTING.md",
        "README.md",
        "ROADMAP.md"
      ]
    },
    "viewer-only": { "include": ["viewer/*.js"] },
    "python-domain": { "include": ["server/polarrecorder/**/*.py"] },
    "duplication-source": { "include": ["viewer/*.js", "plugin.js", "plugin.mjs", "server/polarrecorder/**/*.py"] },
    "markdown-todo": {
      "include": [
        "documentation/**/*.md",
        "AGENTS.md",
        "ARCHITECTURE.md",
        "CLAUDE.md",
        "CONTRIBUTING.md",
        "README.md",
        "ROADMAP.md"
      ]
    }
  }
}
