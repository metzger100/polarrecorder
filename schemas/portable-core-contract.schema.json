{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portable quality core contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "coreVersion",
    "mandatoryRoles",
    "mandatoryPaths",
    "metadataPaths",
    "profileSchemas",
    "canonicalRuleIds",
    "canonicalRuleOwners",
    "canonicalRuleImplementationPaths",
    "requiredCheckerExports",
    "requiredSelfTestRoles"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "coreVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "mandatoryRoles": {
      "type": "object",
      "minProperties": 17,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/definitions/relativePath" }
      }
    },
    "mandatoryPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/relativePath" }
    },
    "metadataPaths": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/relativePath" }
    },
    "profileSchemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/relativePath" }
    },
    "canonicalRuleIds": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "canonicalRuleOwners": {
      "type": "object",
      "minProperties": 21,
      "additionalProperties": { "$ref": "#/definitions/relativePath" }
    },
    "canonicalRuleImplementationPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/relativePath" }
    },
    "requiredCheckerExports": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^run[A-Z][A-Za-z0-9]*$" }
      }
    },
    "requiredSelfTestRoles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/relativePath" }
    }
  },
  "definitions": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
