{
  "$id": "https://schemas.example.invalid/portable-core-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "coreVersion",
    "mandatoryRoles",
    "mandatoryPaths",
    "metadataPaths",
    "profileSchemas",
    "canonicalRuleIds",
    "requiredCheckerExports",
    "requiredSelfTestRoles"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "coreVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "mandatoryRoles": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "paths"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "mandatoryPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "metadataPaths": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "profileSchemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "schemaVersion"],
        "properties": { "path": { "type": "string" }, "schemaVersion": { "const": 1 } }
      }
    },
    "canonicalRuleIds": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredCheckerExports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "exports"],
        "properties": {
          "path": { "type": "string" },
          "exports": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^run[A-Z]" }
          }
        }
      }
    },
    "requiredSelfTestRoles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "tests"],
        "properties": {
          "role": { "type": "string" },
          "tests": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
