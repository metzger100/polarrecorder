{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "portable-profile.schema.json",
  "title": "Portable quality profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileType",
    "portableCore",
    "sourceScopes",
    "languages",
    "testProjects",
    "policies",
    "documentation",
    "adapters"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "profileType": { "type": "string", "const": "product-quality-profile" },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runtime"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "runtime": { "type": "string", "enum": ["browser", "python-plus-browser"] }
      }
    },
    "portableCore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coreVersion", "roleGraph"],
      "properties": {
        "coreVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "roleGraph": { "$ref": "#/$defs/relativePath" }
      }
    },
    "sourceScopes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scope" }
    },
    "languages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "boolean" }
    },
    "testProjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command"],
        "properties": {
          "id": { "$ref": "#/$defs/token" },
          "command": { "$ref": "#/$defs/localCommand" },
          "paths": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "complexity", "fileSize"],
      "properties": {
        "coverage": { "$ref": "#/$defs/relativePath" },
        "complexity": { "$ref": "#/$defs/relativePath" },
        "fileSize": { "$ref": "#/$defs/relativePath" }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots"],
      "properties": {
        "roots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relativePath" } }
      }
    },
    "adapters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/localCommand" }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "roots"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "roots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relativePath" } },
        "extensions": { "type": "array", "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" } }
      }
    },
    "localCommand": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|[ /])(?:/|[A-Za-z]:|\\.\\.(?:/|$))).+$"
    }
  }
}
