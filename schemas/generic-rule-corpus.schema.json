{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "generic-rule-corpus.schema.json",
  "title": "Executable generic-rule conformance corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "rules": {
      "type": "array",
      "minItems": 21,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "clean", "failing", "expectedFailingCount"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "clean": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
        "failing": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
        "expectedFailingCount": { "type": "integer", "minimum": 1 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "content": { "type": "string" },
        "fragments": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "oneOf": [{ "required": ["content"] }, { "required": ["fragments"] }]
    }
  }
}
